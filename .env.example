# Copiar a .env y completar. El archivo .env esta en .gitignore: NUNCA se commitea.

# --- Opcion A: Neo4j local (Docker / Desktop) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=cambiame
# NEO4J_DATABASE=neo4j

# --- Opcion B: Neo4j Aura (nube) ---
# Los valores salen del archivo Neo4j-<id>-Created-<fecha>.txt que Aura
# hace descargar al crear la instancia. Atencion: en algunas instancias
# el usuario y el nombre de la base NO son "neo4j", sino el id de la instancia.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=xxxxxxxx
NEO4J_PASSWORD=cambiame
NEO4J_DATABASE=xxxxxxxx
